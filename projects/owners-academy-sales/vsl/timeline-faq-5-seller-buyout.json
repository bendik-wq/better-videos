{"fps":25,"duration":149.94,"segments":[{"kind":"card","name":"intro","t0":0,"t1":2.8,"html":"<div class=\"num\" data-d=\"0.05\">Pre-call FAQ · Josh answers</div><div class=\"ttl split\" data-d=\"0.2\">Can I buy out a seller who <em>keeps a stake</em>?</div><div class=\"rule\"></div>","fine":""},{"kind":"clip","id":"faq-seller-buyout-a","t0":2.8,"t1":68.7,"in":10140.16,"out":10206.06},{"kind":"clip","id":"faq-seller-buyout-b","t0":68.7,"t1":146.94,"in":10214.06,"out":10292.3},{"kind":"card","name":"end","t0":146.94,"t1":149.94,"html":"<div class=\"num\" data-d=\"0.05\">Pre-call FAQ</div><div class=\"ttl split\" data-d=\"0.2\">Bring your questions <em>to the call</em>.</div><div class=\"rule\"></div>","fine":""}],"beats":[{"t0":2.8,"html":"<div class=\"eyebrow\" data-d=\"0\">Asked live during the masterclass</div><div class=\"big split\" data-d=\"0.15\">Can I buy out a seller who <em>keeps a stake</em>?</div>","clip":"faq-seller-buyout-a","t1":15.8},{"t0":15.8,"html":"<div class=\"eyebrow\" data-d=\"0\">For sellers who roll over equity</div><div class=\"big split\" data-d=\"0.3\">Can you buy them out <em>later</em>?</div>","clip":"faq-seller-buyout-a","t1":30.8},{"t0":30.8,"html":"<div class=\"big split\" data-d=\"0.3\">Yes. Build in an <em>early exit</em>.</div>","clip":"faq-seller-buyout-a","t1":39.3},{"t0":39.3,"html":"<div class=\"eyebrow\" data-d=\"0\">Two options</div><div class=\"row\">\n  <div class=\"card\" data-d=\"0.5\"><div class=\"eyebrow\">Option A</div><div class=\"mid\">Sale option</div><div class=\"small\">After 3 years, buy their share at a fixed price, or a fixed multiple</div></div>\n  <div class=\"card\" data-d=\"20.5\"><div class=\"eyebrow\">Option B</div><div class=\"mid\">Ride it out</div><div class=\"small\">They stay in, and exit when you exit</div></div></div>","clip":"faq-seller-buyout-a","t1":68.7},{"t0":68.7,"html":"<div class=\"big split\" data-d=\"0.15\">They become your <em>business partners</em>. Be fair about it.</div>","clip":"faq-seller-buyout-b","t1":94.2},{"t0":94.2,"html":"<div class=\"eyebrow\" data-d=\"0\">Every seller wants something different</div><div class=\"list\"><div class=\"li\" data-d=\"2.5\"><i>1</i><span>Some will wait 10 years for a bigger exit</span></div><div class=\"li\" data-d=\"11.5\"><i>2</i><span>Some need to be bought out in 6–12 months</span></div></div>","clip":"faq-seller-buyout-b","t1":125.2},{"t0":125.2,"html":"<div class=\"eyebrow\" data-d=\"0\">Buyout triggers</div><div class=\"row\">\n  <div class=\"card\" data-d=\"0.5\"><div class=\"eyebrow\">Trigger 1</div><div class=\"mid\">Time</div><div class=\"small\">After a set number of months or years</div></div>\n  <div class=\"card\" data-d=\"3\"><div class=\"eyebrow\">Trigger 2</div><div class=\"mid\">Size</div><div class=\"small\">Once the business reaches a set size</div></div></div>","clip":"faq-seller-buyout-b","t1":146.94}],"captions":[{"t0":2.92,"words":[["Do",2.92,2.92,0],["you",2.92,3.04,0],["include",3.04,3.44,0],["language",3.44,3.9,0],["to",3.9,4.18,0],["buy",4.18,4.38,0],["out",4.38,4.58,0],["sellers?",4.58,4.96,0]],"t1":5.56},{"t0":6.64,"words":[["Can",6.64,6.9799999999999995,0],["you",6.9799999999999995,7.1,0],["elaborate",7.1,7.359999999999999,0],["on",7.359999999999999,7.66,0],["that?",7.66,7.8999999999999995,0]],"t1":8.5},{"t0":8.82,"words":[["Do",8.82,9,0],["I",9,9.120000000000001,0],["include",9.120000000000001,9.42,0],["language",9.42,9.82,0],["to",9.82,10.1,0],["buy",10.1,10.32,0],["out",10.32,10.559999999999999,0],["sellers?",10.559999999999999,10.879999999999999,0]],"t1":11.479999999999999},{"t0":11.98,"words":[["I",11.98,12.419999999999998,0],["think",12.419999999999998,12.54,0],["I",12.54,12.68,0],["know",12.68,12.82,0],["what",12.82,12.96,0],["you're",12.96,13.079999999999998,0],["asking",13.079999999999998,13.36,0],["but",13.36,13.66,0],["you",13.66,14.52,0]],"t1":14.52},{"t0":14.52,"words":[["just",14.52,14.68,0],["clarify.",14.68,15.14,0],["Do",15.559999999999999,15.68,0],["you",15.68