  },
  "lane": {
   "from": "0:00:30",
   "to": "0:00:37",
   "start": "If you're already in business, you're making cash",
   "end": "and you're growing, stay in your lane"
  },
  "stagnant-a": {
   "from": "0:00:37",
   "to": "0:00:41",
   "start": "If you're in business and you've been stagnant",
   "end": "for the last 15, 20 years"
  },
  "stagnant-b": {
   "from": "0:00:43",
   "to": "0:00:45",
   "start": "Must be some deeper",
   "end": "some deeper issues"
  },
  "scratch": {
   "from": "0:00:54",
   "to": "0:01:07",
   "start": "If you've never been in business before",
   "end": "I chose healthcare"
  },
  "why-hc": {
   "from": "0:01:07",
   "to": "0:01:26",
   "start": "Why did I choose healthcare",
   "end": "the community around me"
  },
  "gp": {
   "from": "0:02:34",
   "to": "0:03:15",
   "start": "Now, it's not to say that I didn't pivot",
   "end": "weren't taking new patients"
  },
  "gp-b": {
   "from": "0:03:16",
   "to": "0:03:30",
   "start": "And I couldn't really have that conversation",
   "end": "navigate through the nuance"
  },
  "physio-b": {
   "from": "0:03:46",
   "to": "0:03:53",
   "start": "How responsive, how receptive",
   "end": "to start those conversations"
  },
  "deal-a": {
   "from": "0:03:53",
   "to": "0:03:58",
   "start": "My first deal was actually",
   "end": "was actually a call back"
  },
  "deal-b": {
   "from": "0:04:34",
   "to": "0:05:00",
   "start": "this was off one cold email",
   "end": "we're in business"
  },
  "deal-c": {
   "from": "0:05:09",
   "to": "0:05:32",
   "start": "The conversation got started",
   "end": "relied on my board of directors"
  },
  "board": {
   "from": "0:05:39",
