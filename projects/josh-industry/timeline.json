.07,"out":643.87},{"kind":"clip","id":"close#2","t0":241.67000000000004,"t1":245.10000000000005,"in":645.09,"out":648.52},{"kind":"card","name":"end","t0":245.10000000000005,"t1":251.10000000000005,"html":"<div class=\"num\" data-d=\"0.05\">For owners of $1M+ businesses</div><div class=\"ttl split\" data-d=\"0.2\">See if your business <em>qualifies</em>.</div><div class=\"rule\"></div><div data-d=\"1.1\" style=\"display:flex;align-items:center;gap:30px;margin-top:10px\"><span class=\"btn\">See if you qualify →</span><span class=\"url\">apply.grosfjeld-li.com</span></div>","fine":"Results are not typical and depend on your business, market and the deals available to you. Nothing in this video is financial, legal or tax advice. Acquisitions involve risk, including the loss of money invested; get independent professional advice before entering any transaction. Some examples are Josh's friends and network, not clients."}],"beats":[{"t0":3,"html":"<div class=\"eyebrow\" data-d=\"0\">The question Josh gets most</div><div class=\"big split\" data-d=\"0.2\">Which industry should you <em>get into</em>?</div>","clip":"q#1","t1":8.56},{"t0":8.56,"html":"<div class=\"eyebrow\" data-d=\"0\">If you already own a business that is</div><div class=\"list\"><div class=\"li\" data-d=\"1.6\"><i>1</i><span>Making cash</span></div><div class=\"li\" data-d=\"2.8\"><i>2</i><span>Profitable</span></div><div class=\"li\" data-d=\"4\"><i>3</i><span>Growing</span></div></div>","clip":"lane#1","t1":13.66},{"t0":13.66,"html":"<div class=\"eyebrow\" data-d=\"0\">Then the answer is simple</div><div class=\"big split\" data-d=\"0.1\">Stay in <mark data-hd=\"0.6\">your lane</mark>.</div>","clip":"lane#1","t1":14.940000000000001},{"t0":14.940000000000001,"html":"<div class=\"eyebrow\" data-d=\"0\">Flat for years?</div><div class=\"big split\" data-d=\"0.3\">Stagnant for <em>15, 20 years</em>?</div>","clip":"stagnant-a#1","t1":19.04},{"t0":19.04,"html":"<div class=\"eyebrow\" data-d=\"0\">Flat for years?</div><div class=\"mid split\" data-d=\"0.1\">There are <em>deeper issues</em> to find first.</div>","clip":"stagnant-b#1","t1":21.84},{"t0":24.44,"html":"<div class=\"eyebrow\" data-d=\"0\">Never been in business?</div><div class=\"big split\" data-d=\"0.6\">Starting <em>from scratch</em>.</div>","clip":"scratch#1","t1":31.240000000000002},{"t0":31.240000000000002,"html":"<div class=\"eyebrow\" data-d=\"0\">Josh, a few years ago</div><div class=\"mid split\" data-d=\"0.8\">\"I'm unemployed. I want to buy companies. <em>What do I do?</em>\"</div>","clip":"scratch#1","t1":36.44},{"t0":36.44,"html":"<div class=\"eyebrow\" data-d=\"0\">Josh's answer</div><div class=\"big split\" data-d=\"0.2\"><em>Healthcare.</em></div>","clip":"scratch#1","t1":38.660000000000004},{"t0":38.660000000000004,"html":"<div class=\"eyebrow\" data-d=\"0\">Why healthcare</div><div class=\"list\"><div class=\"li\" data-d=\"0.8\"><i>1</i><span>His personality gravitates towards it</span></div><div class=\"li\" data-d=\"5.6\"><i>2</i><span>A personal affinity for good health</span></div><div class=\"li\" data-d=\"13.4\"><i>3</i><span>Care for the community around him</span></div></div>","clip":"why-hc#2","t1":53.86},{"t0":56.46,"html":"<div class=\"eyebrow\" data-d=\"0\">Target industry #1</div><div class=\"big split\" data-d=\"3.4\">GP clinics and <em>medical centres</em>.</div>","clip":"gp#1","t1":65.18},{"t0":65.18,"html":"<div class=\"eyebrow\" data-d=\"0\">The timing</div><div class=\"mid split\" data-d=\"0.4\">Melbourne: the world's <em>longest lockdowns</em>.</div>","clip":"gp#3","t1":68.06},{"t0":68.06,"html":"<div class=\"eyebrow\" data-d=\"0\">Melbourne lockdowns</div><div class=\"row\"><div class=\"kpi\" data-d=\"2.8\"><div class=\"v\">~260</div><div class=\"l\">days locked down, by Josh's count</div></div></div>","clip":"gp#4","t1":72.4},{"t0":72.4,"html":"<div class=\"eyebrow\" data-d=\"0\">Meanwhile, the GPs were</div><div class=\"list\"><div class=\"li\" data-d=\"2\"><i>1</i><span>Running government testing sites</span></div><div class=\"li\" data-d=\"7.3\"><i>2</i><span>Stressed out</span></div><div class=\"li\" data-d=\"9.5\"><i>3</i><span>Closing up shop</span></div><div class=\"li\" data-d=\"10.8\"><i>4</i><span>Not taking new patients</span></div></div>","clip":"gp#5","t1":84.66},{"t0":84.66,"html":"<div class=\"eyebrow\" data-d=\"0\">The result</div><div class=\"mid split\" data-d=\"1.2\">No room to talk about <em>buying their business</em>.</div><div class=\"small\" data-d=\"6.8\">And Josh didn't yet know how to navigate the nuance.</div>","clip":"gp-b#1","t1":96.47999999999999},{"t0":96.47999999999999,"html":"<div class=\"eyebrow\" data-d=\"0\">Target industry #2 · the pivot</div><div class=\"big split\" data-d=\"1\">Allied health: <em>physiotherapy</em>.</div>","clip":"physio-p#1","t1":100.46999999999998},{"t0":100.46999999999998,"html":"<div class=\"eyebrow\" data-d=\"0\">After the pivot, owners were</div><div class=\"list\"><div class=\"li\" data-d=\"1.9\"><i>1</i><span>More responsive</span></div><div class=\"li\" data-d=\"3.1\"><i>2</i><span>More receptive</span></div><div class=\"li\" data-d=\"4.7\"><i>3</i><span>Far easier to start a conversation with</span></div></div>","clip":"pivot-made#1","t1":107.36999999999999},{"t0":109.96999999999998,"html":"<div class=\"eyebrow\" data-d=\"0\">Deal #1</div><div class=\"big split\" data-d=\"1\">It started with a <em>call back</em>.</div>","clip":"deal-a#1","t1":113.86999999999999},{"t0":113.86999999999999,"html":"<div class=\"eyebrow\" data-d=\"0\">How it happened</div><div class=\"list\"><div class=\"li\" data-d=\"1.9\"><i>1</i><span>One cold email</span></div><div class=\"li\" data-d=\"6\"><i>2</i><span>Sent to the front-desk inbox</span></div><div class=\"li\" data-d=\"11.4\"><i>3</i><span>Reception flicked it to the owner</span></div></div>","clip":"deal-b#1","t1":128.57},{"t0":128.57,"html":"<div class=\"eyebrow\" data-d=\"0\">The owner called Josh back</div><div class=\"mid split\" data-d=\"3.3\">\"Got your email. <em>I'm interested.</em> What's the go?\"</div><div class=\"small\" data-d=\"6.6\">A quick one-liner, and the conversation started.</div>","clip":"deal-b#1","t1":139.25},{"t0":139.25,"html":"<div class=\"eyebrow\" data-d=\"0\">Deal #1</div><div class=\"mid split\" data-d=\"1.5\">The owner liked his <em>process and approach</em>.</div>","clip":"deal-c#1","t1":143.87},{"t0":143.87,"html":"<div class=\"eyebrow\" data-d=\"0\">Deal #1 · the outcome</div><div class=\"row\"><div class=\"kpi\" data-d=\"0.5\"><div class=\"v\">Months</div><div class=\"l\">to close the deal</div></div><div class=\"kpi\" data-d=\"5\"><div class=\"v\">100%</div><div class=\"l\">vendor finance</div></div></div>","clip":"deal-c#2","t1":151.47},{"t0":151.47,"html":"<div class=\"eyebrow\" data-d=\"0\">He didn't know what he was doing</div><div class=\"mid split\" data-d=\"0.4\">So he relied on his <mark data-hd=\"1.6\">board of directors</mark>.</div>","clip":"deal-c#2","t1":154.18},{"t0":154.18,"html":"<div class=\"eyebrow\" data-d=\"0\">What made it work</div><div class=\"big split\" data-d=\"0.1\">Not knowing <em>the industry</em>.</div>","clip":"board#1","t1":156.28},{"t0":156.28,"html":"<div class=\"eyebrow\" data-d=\"0\">What made it work</div><div class=\"mid split\" data-d=\"0.5\">Recruiting people who <em>knew more than him</em>.</div><div class=\"small\" data-d=\"6\">To advise and govern the direction of the company.</div>","clip":"board#1","t1":167.12},{"t0":169.72,"html":"<div class=\"eyebrow\" data-d=\"0\">Acquisitions</div><div class=\"mid split\" data-d=\"0.9\">Difficult, and suited to a <em>particular archetype</em>.</div>","clip":"archetype#1","t1":176.52},{"t0":176.52,"html":"<div class=\"eyebrow\" data-d=\"0\">But you don't have to be</div><div class=\"list\"><div class=\"li\" data-d=\"1.2\"><i>1</i><span>Like Josh</span></div><div class=\"li\" data-d=\"2.4\"><i>2</i><span>Extroverted</span></div><div class=\"li\" data-d=\"6.8\"><i>3</i><span>A loudmouth alpha</span></div></div><div class=\"small\" data-d=\"10.2\">Quieter people can make this work too.</div>","clip":"archetype#1","t1":192.92},{"t0":192.92,"html":"<div class=\"eyebrow\" data-d=\"0\">It's a learning curve</div><div class=\"big split\" data-d=\"1.4\"><mark data-hd=\"2.2\">Tailor the industry</mark> to you.</div><div class=\"small\" data-d=\"4\">Put yourself in a position to succeed.</div>","clip":"archetype#1","t1":199.27},{"t0":199.27,"html":"<div class=\"eyebrow\" data-d=\"0\">Josh could have chosen</div><div class=\"list\"><div class=\"li\" data-d=\"0.8\"><i>1</i><span>Finance</span></div><div class=\"li\" data-d=\"1.7\"><i>2</i><span>Accounting</span></div><div class=\"li\" data-d=\"2.5\"><i>3</i><span>Legal firms</span></div></div>","clip":"match#1","t1":204.97},{"t0":204.97,"html":"<div class=\"eyebrow\" data-d=\"0\">More geared to blue collar?</div><div class=\"mid split\" data-d=\"1.4\">Then go into the <em>groundwork</em> industries.</div>","clip":"match#1","t1":213.81000000000003},{"t0":213.81000000000003,"html":"<div class=\"eyebrow\" data-d=\"0\">Example · Christian, Victoria</div><div class=\"big split\" data-d=\"4.3\">Waste and <em>energy</em>.</div>","clip":"christian#1","t1":222.65000000000003},{"t0":222.65000000000003,"html":"<div class=\"eyebrow\" data-d=\"0\">Why it fits Christian</div><div class=\"list\"><div class=\"li\" data-d=\"0.6\"><i>1</i><span>A trade background</span></div><div class=\"li\" data-d=\"1.8\"><i>2</i><span>A personality and demeanour that suit the work</span></div></div>","clip":"christian#3","t1":229.87000000000003},{"t0":229.87000000000003,"html":"<div class=\"eyebrow\" data-d=\"0\">Picking your industry</div><div class=\"big split\" data-d=\"1.2\">Stop <em>overthinking it</em>.</div>","clip":"close#1","t1":233.07000000000002},{"t0":233.07000000000002,"html":"<div class=\"eyebrow\" data-d=\"0\">Be critical about</div><div class=\"list\"><div class=\"li\" data-d=\"1.8\"><i>1</i><span>Who you are</spa