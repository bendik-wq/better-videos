    { "id": "object", "padIn": 1.6, "padOut": 0.8,
      "vo": "The most important invention in the history of global trade wasn't a machine. It was a steel box." },
    { "id": "harbor", "padIn": 0.5, "padOut": 0.9,
      "vo": "On April twenty-sixth, nineteen fifty-six, a converted oil tanker called the Ideal X left Port Newark, New Jersey, carrying fifty-eight of them." },
    { "id": "numbers", "padIn": 0.5, "padOut": 1.0,
      "vo": "Loading a ship by hand cost five dollars and eighty-three cents a ton. In a box, it would cost under sixteen cents." },
    { "id": "canyon", "padIn": 0.5, "padOut": 0.8,
      "vo": "The man behind it wasn't a shipping man. Malcom McLean was a trucker. And to get his ships, he bought a shipping company, largely with borrowed money." },
